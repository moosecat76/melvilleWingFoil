rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // A user can only read/write documents under their own user ID.
    // Tip: To lock Firestore strictly to your single Google account at the database rule level,
    // add `&& request.auth.token.email == "your-email@gmail.com"` inside isOwner(userId).
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
  }
}
